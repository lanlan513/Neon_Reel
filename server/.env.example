# Neon Reel API — optional environment overrides.
# Copy to `.env` (git-ignored) only if you need to change the defaults.
# The server reads these at boot; nothing here is required to run the project.

# HTTP port for the API server. Must stay in sync with the `server.proxy.target`
# in client/vite.config.ts. Default: 4100.
PORT=4100

# Absolute path to the SQLite file. Default: server/data/neon-reel.sqlite
# DB_PATH=/absolute/path/to/neon-reel.sqlite

# Comma-separated list of browser origins allowed to call the API.
# Default: http://localhost:5199,http://127.0.0.1:5199
# CORS_ORIGINS=http://localhost:5199,http://127.0.0.1:5199
