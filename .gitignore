server/data/*.sqlite
server/data/*.sqlite-*
server/data/*.db
server/data/*.db-*

# env & secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
logs/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# test / coverage
coverage/
.nyc_output/
